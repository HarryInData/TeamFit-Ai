# ── Server ──
APP_ENV=development
FLASK_DEBUG=false
FLASK_PORT=5001
PORT=5001
TOKEN_TTL_SECONDS=3600

# ── Security ──
SECRET_KEY=generate-a-random-secret-at-least-32-characters-long

# ── Database ──
# Leave empty for SQLite (default), or set PostgreSQL URL for production
DATABASE_URL=

# ── AI ──
GROQ_API_KEY=your_groq_api_key_here

# ── Firebase Authentication ──
# The Web API key is public Firebase app configuration, not a service-account secret.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ── Code Execution ──
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com
# For a self-hosted Judge0 endpoint, configure its AUTHZ_HEADER/AUTHZ_TOKEN:
JUDGE0_AUTH_HEADER=
JUDGE0_AUTH_TOKEN=

# ── CORS ──
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: set CORS_ORIGINS=https://team-fit-ai.vercel.app (plus any real custom domain).
