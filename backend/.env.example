# ── Server ──
APP_ENV=development
FLASK_DEBUG=false
FLASK_PORT=5001
PORT=5001
TOKEN_TTL_SECONDS=3600

# ── Security ──
SECRET_KEY=generate-a-random-secret-at-least-32-characters-long

# ── Database ──
# Leave empty for SQLite (default), or set PostgreSQL URL for production
DATABASE_URL=

# ── AI ──
GROQ_API_KEY=

# ── Firebase Authentication ──
# The Web API key is public Firebase app configuration, not a service-account secret.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=

# ── Self-hosted Piston (set URL to a private HTTPS endpoint in production) ──
PISTON_URL=http://127.0.0.1:2000
PISTON_AUTH_HEADER=
PISTON_AUTH_TOKEN=

# ── CORS ──
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Production: set CORS_ORIGINS=https://team-fit-ai.vercel.app (plus any real custom domain).
